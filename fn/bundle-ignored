#!/usr/bin/env zsh

function bundle-ignored() {
  emulate -L zsh
  setopt LOCAL_TRAPS
  typeset -ri ZOPFLI_MAX_BYTES=$((50 * 1024 * 1024))

  local bundle_root bundle ignored
  bundle_root="$(pwd)"
  bundle="${1:-bundle}"

  function tar_gz() {
    local archive="${1%/}"
    local tmp_file="${archive}.tar"
    local cmd size
    tar -cvf "${tmp_file}" --exclude=".DS_Store" -- "${archive}" || return 1

    size="$(stat -f '%z' "${tmp_file}" 2>/dev/null)" || size="$(stat -c '%s' "${tmp_file}" 2>/dev/null)" || return 1

    if (( size < ZOPFLI_MAX_BYTES )) && command -v zopfli >/dev/null; then
      cmd="zopfli"
    elif command -v pigz >/dev/null; then
      cmd="pigz"
    else
      cmd="gzip"
    fi

    print "Compressing .tar using ${cmd}…"
    "${cmd}" -v "${tmp_file}" || return 1
    if [[ -f "${tmp_file}" ]]; then
      rm -- "${tmp_file}" || return
    fi
    print "${bundle_root}/${bundle}.tar.gz created successfully."
  }

  function copy_files() {
    local file dest dir
    for file in "$@"; do
      [[ -z "${file}" ]] && continue
      dest="${bundle}/${file}"
      dir="${dest:h}"
      mkdir -p -- "${dir}" || return
      cp -R -- "${file}" "${dest}" || return
    done

    tar_gz "${bundle}" || return
    if [[ -d "${bundle}" ]]; then
      rm -rf -- "${bundle}" || return
    fi
    print "FINISHED!"
  }

  trap 'unfunction tar_gz copy_files 2>/dev/null' EXIT

  mkdir -p -- "${bundle}" || return
  node "${bundle_root}/copy-dotfiles.mjs" "${bundle}" || return

  ignored="$(git ls-files -o -x .DS_Store -x Library -x tmp -x secrets.tar.gz -x cache -x home/bin -x "${bundle}")" || return
  print "About to copy the following ignored files:"
  print -r -- "${ignored}"
  copy_files "${(@f)ignored}"
}

bundle-ignored "$@"
