emulate -L zsh
setopt LOCAL_TRAPS

local dir mount_point

if [[ -z "${RMOUNT_DIR}" || ! -d "${RMOUNT_DIR}" ]]; then
  print -u2 "RMOUNT_DIR is not set or is not a directory"
  return 1
fi

function unmount_one() {
  local point="${1}"
  if mount | grep -F -q -- " on ${point} "; then
    umount "${point}" || return
  fi
  if [[ -d "${point}" ]]; then
    local -a contents=("${point}"/*(ND))
    if (( ${#contents[@]} == 0 )); then
      rmdir -- "${point}" || return
    fi
  fi
}
trap 'unfunction unmount_one 2>/dev/null' EXIT

if [[ -z "${1:-}" ]]; then
  local -a dirs=("${RMOUNT_DIR}"/*(N/))
  if (( ${#dirs[@]} == 0 )); then
    print "No volumes to unmount"
    return 0
  fi
  print "Which volume do you want to unmount?"
  print " * -a (for all)"
  for dir in "${dirs[@]}"; do
    print " * ${dir:t}"
  done
  return 0
fi

if [[ "${1}" == "-a" ]]; then
  for dir in "${RMOUNT_DIR}"/*(N/); do
    unmount_one "${dir}" || return
  done
  return 0
fi

mount_point="${RMOUNT_DIR}/${1}"
unmount_one "${mount_point}" || return
