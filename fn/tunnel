#!/usr/bin/env zsh

function tunnel() {
  typeset -r default_remote_port=8080
  typeset -r default_local_port=9999
  local server="${1:-}" remote_port="${2:-}" local_port="${3:-}" pid

  if [[ -z "${server}" ]]; then
    cat <<'EOF'
tunnel db connector
  * Uses ssh tunnel to proxy to localhost:[9999]

EXAMPLES
  # connects to example.com on default remote :8080 and localhost:9999:
    tunnel user@example.com

  # connects to example.com on custom remote :8090 and localhost:9999:
    tunnel user@example.com 8090

  # connects to example.com on custom remote :8090 and localhost:9191:
    tunnel user@example.com 8090 9191

Type the user@server.com address for the server.
EOF
    read -r server
  fi

  if [[ -z "${server}" ]]; then
    print "No server specified. Bailing."
    return 1
  fi
  if [[ "${server}" == -* || "${server}" == *[[:space:]]* ]]; then
    print -u2 "tunnel: invalid server"
    return 1
  fi

  if [[ -z "${remote_port}" ]]; then
    print "Change the remote db port? Default is ${default_remote_port}"
    read -r remote_port
    remote_port="${remote_port:-${default_remote_port}}"
    print "Using ${remote_port}"
  fi

  if [[ -z "${local_port}" ]]; then
    print "Change the localhost port? Default is ${default_local_port}"
    read -r local_port
    local_port="${local_port:-${default_local_port}}"
    print "Using ${local_port}"
  fi

  if [[ ! "${remote_port}" == <-> || ! "${local_port}" == <-> ]]; then
    print -u2 "tunnel: ports must be numbers"
    return 1
  fi

  print "Connecting…"
  print -r -- "ssh -N -L ${local_port}:127.0.0.1:${remote_port} ${server}"
  print ""
  print "Access the database at http://localhost:${local_port}"
  print ""

  ssh -N -o ExitOnForwardFailure=yes -L "${local_port}:127.0.0.1:${remote_port}" "${server}" &
  pid=$!
  disown "${pid}"
  print "When you are finished, run the following command:"
  print "kill ${pid}"
}

tunnel "$@"
