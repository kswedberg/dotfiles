#!/usr/bin/env zsh

function keycopy() {
  local key="" candidate user="${1:-}" server="${2:-}"
  local -a names=(id_ed25519.pub id_rsa.pub id_dsa.pub)

  for candidate in "${names[@]}"; do
    if [[ -f "${HOME}/.ssh/${candidate}" ]]; then
      key="${HOME}/.ssh/${candidate}"
      break
    fi
  done

  if [[ -z "${key}" ]]; then
    print -u2 "Public key not found in ${HOME}/.ssh"
    print -u2 "Tried: ${(j:, :)names}"
    print -u2 "Create one with: ssh-keygen -t ed25519"
    return 1
  fi

  if [[ -z "${user}" ]]; then
    about "SSH Key Copier"
    example "keycopy username servername"
    return 1
  fi

  if [[ -z "${server}" ]]; then
    print "Please provide a server name:"
    read -r server
  fi
  if [[ -z "${server}" ]]; then
    print "Aborting key copy. No server name."
    return 1
  fi

  if ! command -v ssh-copy-id >/dev/null; then
    print -u2 "keycopy: ssh-copy-id not found"
    return 1
  fi

  print "Putting your key on ${server}..."
  ssh-copy-id -i "${key}" "${user}@${server}" || return
  print "copied key for ${user} to ${server}"
}

keycopy "$@"
