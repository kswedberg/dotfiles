if (( $# == 0 )); then
  about 'remove a directory…if you confirm'
  example 'rmrf foo'
  example 'rmrf /tmp/img/photos/large'
  return 1
fi
if [[ ! -e "${1}" ]]; then
  print "File ${1} doesn't exist."
  return 1
fi
if [[ "${1:a}" == "/" ]]; then
  print -u2 "rmrf: refusing to remove /"
  return 1
fi

ls -lash "${1:a}" || return 1
print ""
print -n "Are you sure you want to delete ${1}? [y/N] "
local confirm
read -r confirm
if [[ "${confirm}" == "y" ]]; then
  rm -rf -- "${1}" || return
  print "Deleted ${1}"
else
  print "Okay, not gonna do it"
  return 1
fi
