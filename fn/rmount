local host folder mname

if [[ -z "${RMOUNT_DIR}" || ! -d "${RMOUNT_DIR}" ]]; then
  print -u2 "RMOUNT_DIR is not set or is not a directory"
  return 1
fi
if [[ -z "${1:-}" ]]; then
  print -u2 "usage: rmount user@host[:path] [name]"
  return 1
fi

host="${1%%:*}:"
if [[ "${1%:}" == "${host%%:*}" ]]; then
  folder=""
else
  folder="${1##*:}"
fi

if [[ -n "${2:-}" ]]; then
  mname="${2}"
else
  mname="${folder##*/}"
  [[ -z "${mname}" ]] && mname="${host%%:*}"
fi
mname="${mname##*@}"

mkdir -p -- "${RMOUNT_DIR}/${mname}" || return
sshfs "${host}${folder}" "${RMOUNT_DIR}/${mname}" -oauto_cache,reconnect,defer_permissions,negative_vncache,volname="${mname}",noappledouble || return
cd -- "${RMOUNT_DIR}/${mname}" || return
print "mounted ${RMOUNT_DIR}/${mname}"
