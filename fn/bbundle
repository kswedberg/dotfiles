#!/usr/bin/env zsh

function bbundle() {
  local brewfile="${DOTFILES:-}/Brewfile"
  local option=""
  typeset -a options=(Install "Update/Create" Show Bail)

  if [[ -z "${DOTFILES:-}" ]]; then
    print -u2 "DOTFILES is not set"
    return 1
  fi

  print "Do you want to:"
  print -P "%BInstall%b apps listed in ${brewfile//\%/%%} (default), or"
  print -P "%BUpdate/Create%b the Brewfile based on your current apps, or"
  print -P "%BShow%b Brewfile"
  print -P "%BBail%b"
  print ""

  select option in "${options[@]}"; do
    [[ -n "${option}" ]] && break
    print -u2 "Choose a number from the list."
  done

  if [[ -z "${option}" ]]; then
    print -u2 "Cancelled"
    return 1
  fi

  case "${option}" in
    Bail)
      print "${option}"
      print "Okay. Bailing…"
      ;;
    Show)
      print "Showing ${brewfile} …"
      command cat "${brewfile}"
      ;;
    Update/Create)
      print "Running brew bundle dump --force --file=${brewfile} …"
      brew bundle dump --force --file="${brewfile}"
      ;;
    Install)
      print "Running brew bundle --file=${brewfile} …"
      brew bundle --file="${brewfile}"
      ;;
  esac
}

bbundle "$@"
