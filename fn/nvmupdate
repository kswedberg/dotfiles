#!/usr/bin/env zsh

function nvmupdate() {
  local new_version="${1:-}" reinstall="${2:-}"
  local msg
  typeset -a cmd

  if [[ -z "${new_version}" ]]; then
    print "nvm updater"
    print "* installs node to specified version and reinstalls packages from another version if specified"
    print ""
    print "Example Usage:"
    print "\t# updates node to latest stable and reinstalls global packages from 5.2"
    print "\tnvmupdate node 5.2"
    print ""
    print "Type a version name or node to install."
    read -r new_version
  fi

  if [[ -z "${new_version}" ]]; then
    print "No version specified. Bailing."
    return 1
  fi
  if [[ ! "${new_version}" =~ '^[A-Za-z0-9._-]+$' ]]; then
    print -u2 "nvmupdate: version contains unsupported characters"
    return 1
  fi
  if [[ ! -s "${NVM_DIR:-}/nvm.sh" ]]; then
    print -u2 "nvmupdate: NVM_DIR/nvm.sh is not available"
    return 1
  fi

  source "${NVM_DIR}/nvm.sh" || return

  if [[ -z "${reinstall}" ]]; then
    print "If you wanna reinstall global node packages, provide the version to copy from."
    print "Maybe one of these (without the \"v\")…"
    nvm ls
    print ""
    read -r reinstall
  fi
  if [[ -n "${reinstall}" && ! "${reinstall}" =~ '^[A-Za-z0-9._-]+$' ]]; then
    print -u2 "nvmupdate: source version contains unsupported characters"
    return 1
  fi

  cmd=(nvm install "${new_version}")
  msg="Installing version '${new_version}' without reinstalling packages"
  if [[ -n "${reinstall}" ]]; then
    msg="Installing version '${new_version}' with packages from ${reinstall}"
    cmd+=(--reinstall-packages-from="${reinstall}")
  fi

  print "${msg}"
  "${cmd[@]}"
}

nvmupdate "$@"
