# Quit Mac apps politely so they can save work.
# Based on Jon Stovell, 2009, with -f from Jerry Krinock, 2011.

emulate -L zsh
setopt LOCAL_TRAPS
typeset -ri QUIT_WAIT_LIMIT=10

local appname="" save_action="" scriptable="" search_all="false"
local is_contains="is" ignore_not_running="false" unscriptable_warning_shown="false"
local REPLY="" opt arg count
typeset -i need_to_save=0
local OPTIND=1

function usage() {
  print "Usage: quit [-a] [-p] [-s|n] [-f] <application names>"
  print ""
  print "Arguments are the names of one or more applications."
  print "Arguments are not case sensitive."
  print "Arguments with spaces should be quoted."
  print ""
  print "Options:"
  print " -a Match argument string with any of the application's"
  print "    name, displayed name, short name, or title."
  print "    E.g.: quit \"microsoft word\" and quit -a word"
  print "    will both quit Microsoft Word, because the app calls"
  print "    itself \"Word\" in the menu bar."
  print " -p Use partial matches (e.g. edit for TextEdit). Prompts"
  print "    for confirmation."
  print " -s Attempt to save modified files when quitting."
  print "    Overrides any previous -n option."
  print " -n Do not attempt to save modified files when quitting."
  print "    Overrides any previous -s option."
  print " -f Do not print an error message if app is not running"
  print ""
  print "If neither the -s or -n options are specified, quit will try"
  print "to determine if any documents require saving, and if necessary"
  print "will ask the user whether to save or not."
  print ""
  return 65
}

function count_running() {
  osascript - "${1}" <<'EOF'
on run argv
  set appName to item 1 of argv
  tell application "System Events" to count (application processes whose displayed name is appName)
end run
EOF
}

function quit_app() {
  osascript - "${appname}" "${save_action}" <<'EOF'
on run argv
  set appName to item 1 of argv
  set saveAction to item 2 of argv
  ignoring application responses
    if saveAction is "saving yes" then
      tell application appName to quit saving yes
    else if saveAction is "saving no" then
      tell application appName to quit saving no
    else
      tell application appName to quit
    end if
  end ignoring
end run
EOF
}

function find_apps() {
  osascript - "${1}" "${is_contains}" "${search_all}" <<'EOF'
on run argv
  set query to item 1 of argv
  set matcher to item 2 of argv
  set searchAll to item 3 of argv
  tell application "System Events"
    if searchAll is "true" then
      if matcher is "contains" then
        return displayed name of every application process whose displayed name contains query or name contains query or short name contains query or title contains query
      else
        return displayed name of every application process whose displayed name is query or name is query or short name is query or title is query
      end if
    else if matcher is "contains" then
      return displayed name of every application process whose displayed name contains query
    else
      return displayed name of every application process whose displayed name is query
    end if
  end tell
end run
EOF
}

function check_if_scriptable() {
  scriptable="$(osascript - "${appname}" <<'EOF'
on run argv
  set appName to item 1 of argv
  tell application "System Events" to return has scripting terminology of first application process whose displayed name is appName
end run
EOF
)" || return 1
}

function check_for_modified_documents() {
  local raw
  raw="$(osascript - "${appname}" <<'EOF'
on run argv
  set appName to item 1 of argv
  try
    tell application appName to count (get its documents whose modified is true)
  on error
    try
      tell application appName to count (get its documents whose saved is false)
    on error
      return -1
    end try
  end try
end run
EOF
)" || return 1
  need_to_save="${raw}"
}

function prompt_for_save_action() {
  if (( need_to_save > 1 )); then
    print -u2 "Save changes to ${need_to_save} modified documents? (Press Ctrl-C to cancel)"
  elif (( need_to_save == 1 )); then
    print -u2 "Save changes to ${need_to_save} modified document? (Press Ctrl-C to cancel)"
  elif (( need_to_save == -1 )); then
    print -u2 "Save changes to modified documents (if any)? (Press Ctrl-C to cancel)"
  fi
  print -nu 2 -- "(y/n): "
  read -k 1 REPLY
  print -u 2

  if [[ "${REPLY}" == y ]]; then
    save_action="saving yes"
  elif [[ "${REPLY}" == n ]]; then
    save_action="saving no"
  else
    if [[ -n "${REPLY}" && "${REPLY}" != $'\n' ]]; then
      print -u2 "Invalid response. Aborted."
    fi
    return 1
  fi
}

function set_save_action() {
  if [[ -z "${save_action}" ]]; then
    check_for_modified_documents || return
    if (( need_to_save >= 1 )) || { (( need_to_save == -1 )) && [[ "${scriptable}" == true ]]; }; then
      prompt_for_save_action || return
    fi
  fi
}

function tell_to_quit() {
  typeset -i running_apps wait_count=0 still_running
  unscriptable_warning_shown="false"

  count="$(count_running "${appname}")" || return 1
  running_apps="${count}"
  quit_app || return 1
  sleep 1

  count="$(count_running "${appname}")" || return 1
  still_running="${count}"
  while (( still_running >= running_apps && wait_count < QUIT_WAIT_LIMIT )); do
    if [[ "${scriptable}" == false && "${unscriptable_warning_shown}" == false ]]; then
      print -u2 "${appname} does not respond to standard scripting terminology."
      print -u2 "If it has unsaved changes, it may not quit."
      unscriptable_warning_shown="true"
    fi

    sleep 1
    (( wait_count++ ))
    if (( wait_count != QUIT_WAIT_LIMIT )); then
      print -nu 2 -- "."
    else
      print -nu 2 -- "."
      sleep 1
      print -u 2
      print -u2 -- "${appname} has not quit. Give up?"
      print -nu 2 -- "(y/n): "
      read -k 1 REPLY
      print -u 2
      if [[ "${REPLY}" != y ]]; then
        wait_count=0
      fi
    fi

    count="$(count_running "${appname}")" || return 1
    still_running="${count}"
  done

  if (( wait_count > 0 && wait_count != QUIT_WAIT_LIMIT )); then
    print -u 2
  fi
  if [[ "${scriptable}" == false && "${unscriptable_warning_shown}" == true ]] && (( still_running < running_apps )); then
    print -u 2 "${appname} has quit."
  fi
}

function prompt_for_app() {
  local -a choices
  choices=("${(@s:, :)appname}")
  print -u 2 "Choose the application to quit (Press Ctrl-C to cancel):"
  select appname in "${choices[@]}"; do
    if [[ -z "${appname}" ]]; then
      print -u 2 "Please select by number."
    else
      break
    fi
  done
  [[ -n "${appname}" ]]
}

function quit_matched() {
  check_if_scriptable || return
  set_save_action || return
  tell_to_quit || return
}

trap 'unfunction usage count_running quit_app find_apps check_if_scriptable check_for_modified_documents prompt_for_save_action set_save_action tell_to_quit prompt_for_app quit_matched 2>/dev/null' EXIT

while getopts ":apnsf" opt; do
  case "${opt}" in
    a) search_all="true" ;;
    p) is_contains="contains" ;;
    n) save_action="saving no" ;;
    s) save_action="saving yes" ;;
    f) ignore_not_running="true" ;;
    \?) usage || return ;;
  esac
done
shift $(( OPTIND - 1 ))

if [[ -z "${1:-}" ]]; then
  usage || return
fi

for arg in "$@"; do
  appname="$(find_apps "${arg}")" || return
  if [[ -n "${appname}" && "${appname}" != *", "* ]]; then
    if [[ "${is_contains}" == "is" ]]; then
      quit_matched || return
    else
      prompt_for_app || return
      quit_matched || return
    fi
  elif [[ -z "${appname}" ]]; then
    if [[ "${ignore_not_running}" == false ]]; then
      print -u2 "No running application matches \"${arg}\""
    fi
  else
    print -u2 "\"${arg}\" matches multiple applications."
    prompt_for_app || return
    quit_matched || return
  fi
done
