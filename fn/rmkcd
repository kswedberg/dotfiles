if (( $# == 0 )); then
  about 'remove a directory, then make one its place and cd into it'
  example 'rmkcd foo'
  example 'rmkcd /tmp/img/photos/large'
  return 1
fi
if (( $# != 1 )); then
  print -u2 "rmkcd: expected one directory"
  return 1
fi

local dir="${1}"
if [[ "${dir}" == "." || "${dir}" == ".." || "${dir:a}" == "/" ]]; then
  print -u2 "rmkcd: refusing to remove ${dir}"
  return 1
fi

rm -rf -- "${dir}" || return
mkdir -p -- "${dir}" || return
cd -- "${dir}" || return
