#!/usr/bin/env zsh

function setup-file-extension-open-with() {
  emulate -L zsh
  setopt LOCAL_TRAPS ERR_EXIT NO_UNSET PIPE_FAIL

  typeset -ar extensions=(
    .cfg
    .conf
    .css
    .csv
    .erb
    .html
    .js
    .json
    .jsx
    .log
    .md
    .njk
    .php
    .plist
    .py
    .rb
    .scss
    .sh
    .svg
    .toml
    .tpl
    .ts
    .twig
    .xml
    .yaml
    .yml
  )

  function create_dummy_files() {
    local dummy_dir="${DOTFILES}/dummies"
    local dummy_file file

    if [[ ! -d "${dummy_dir}" ]]; then
      mkdir -- "${dummy_dir}"
    fi

    for file in "$@"; do
      dummy_file="${dummy_dir}/dummy${file}"
      if [[ ! -e "${dummy_file}" ]]; then
        print "creating ${dummy_file}"
        mkfile 1b "${dummy_file}"
      fi
    done

    print ""
    print "1. open ${dummy_dir}"
    print "2. select all files"
    print "3. press ⌘⌥i and do the 'Open with' / 'Change All...' thing"
    print ""
    print "You can then delete the ${dummy_dir} directory"
  }

  trap 'unfunction create_dummy_files 2>/dev/null' EXIT

  if [[ -z "${DOTFILES:-}" ]]; then
    print -u2 "Error: DOTFILES environment variable is not set"
    return 1
  fi

  create_dummy_files "${extensions[@]}"
}

setup-file-extension-open-with "$@"
