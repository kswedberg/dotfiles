local usage
usage=$'Requires wget\n\nUsage: dl-site URL [DOMAIN]\nScrape the web site at URL, optionally restricted to a given DOMAIN.'

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  print -r -- "${usage}"
  return 0
fi
if [[ -z "${1:-}" ]]; then
  print -r -- "${usage}"
  return 1
fi

typeset -a wget_args=(
  --recursive
  --no-clobber
  --page-requisites
  --html-extension
  --convert-links
  --restrict-file-names=windows
  --no-parent
)
if [[ -n "${2:-}" ]]; then
  wget_args+=(--domains "${2}")
fi
wget_args+=(-- "${1}")
wget "${wget_args[@]}"
